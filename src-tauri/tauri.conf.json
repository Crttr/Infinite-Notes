{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Infinite Notes",
  "version": "0.2.0",
  "identifier": "com.infinitenotes.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Infinite Notes",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 550,
        "backgroundColor": "#211a26"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
